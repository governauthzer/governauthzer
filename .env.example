# Per-destination deploy values. Copy to the env file for the destination you are
# deploying (gitignored), fill it in, then `kamal deploy -d <destination>` with no
# manual exports. config/deploy.<destination>.yml loads its own file via dotenv, so
# names here need no prefix — destinations never load together.
#
#   cp .env.example .env.production && $EDITOR .env.production
#
# Nothing here belongs in git. Back the file up in a password manager: losing the
# encryption keys loses every encrypted value (OIDC client secrets), and the database
# passwords are baked into the Postgres volume on its first boot.

# Public hostname (DNS A record → your server). Also becomes GOVERNAUTHZER_HOST, which
# is what mail and webhook links are built from.
DOMAIN=governauthzer.example.com

# The machine Kamal deploys to — the web host and the Postgres accessory host. Leave
# unset when DNS already points at the box and DOMAIN reaches it; set it to an IP when
# it does not.
# SERVER_HOST=203.0.113.10

# GitHub login used to authenticate against ghcr.io. The package is public, so pulling
# needs no rights — Kamal simply requires a credential for any non-localhost registry.
# The token comes from the gh CLI (see .kamal/secrets.production), so there is nothing
# to store or rotate here.
GHCR_USER=your-github-login

# Signs session cookies. Changing it signs everyone out. Generate once:
#   openssl rand -hex 64
SECRET_KEY_BASE=change-me

# Encryption at rest for OIDC client secrets and webhook signing secrets. The app
# refuses to boot without all three. Generate once:
#   bin/governauthzer generate-encryption-keys
GOVERNAUTHZER_ENCRYPTION_PRIMARY_KEY=change-me
GOVERNAUTHZER_ENCRYPTION_DETERMINISTIC_KEY=change-me
GOVERNAUTHZER_ENCRYPTION_KEY_DERIVATION_SALT=change-me

# Two database roles, two passwords — this is the audit-log protection, not ceremony.
# The app serves as the restricted role, which cannot UPDATE or DELETE audit_events;
# migrations and db/grants.sql run as the owner. See docs/audit-log-protection.md.
# Generate each once:
#   openssl rand -hex 24
GOVERNAUTHZER_DATABASE_PASSWORD=change-me   # restricted runtime role (governauthzer_app)
POSTGRES_PASSWORD=change-me                 # owner/migrator role (governauthzer)

# Outgoing mail. Leave SMTP_HOST unset to run without mail: approval notifications
# then fail quietly in the background and the in-app inbox carries the workflow.
# Setting SMTP_HOST wires the rest in automatically.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=governauthzer@example.com
# SMTP_PASSWORD=change-me
# SMTP_TLS=true

# Error tracking, off unless a DSN is set.
# SENTRY_DSN=
