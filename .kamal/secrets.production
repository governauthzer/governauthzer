# Secrets for the `production` destination — Kamal loads this (plus
# .kamal/secrets-common) when you deploy with `-d production`; the plain
# .kamal/secrets is only for the default (no-destination) deploy. Values here are
# references only — no raw credentials, safe for git. They come from the gitignored
# `.env.production`, which config/deploy.production.yml loads into ENV before these
# resolve, so nothing needs a manual export.

# GHCR. The package is public, so no credential is needed to *pull* it — Kamal's
# validator simply requires one for any non-localhost registry. Reusing the gh CLI's
# own token means there is no PAT to store or rotate. It carries no packages scope
# and does not need one; ghcr.io accepts it for login, and that is all a public pull
# takes.
KAMAL_REGISTRY_PASSWORD=$(gh config get -h github.com oauth_token)

# Not RAILS_MASTER_KEY: governauthzer takes every secret from the environment, so
# there is no credentials file to unlock and no master key to ship to an operator.
SECRET_KEY_BASE=$SECRET_KEY_BASE

# Encryption at rest for OIDC client secrets and webhook signing secrets. The app
# refuses to boot without all three.
GOVERNAUTHZER_ENCRYPTION_PRIMARY_KEY=$GOVERNAUTHZER_ENCRYPTION_PRIMARY_KEY
GOVERNAUTHZER_ENCRYPTION_DETERMINISTIC_KEY=$GOVERNAUTHZER_ENCRYPTION_DETERMINISTIC_KEY
GOVERNAUTHZER_ENCRYPTION_KEY_DERIVATION_SALT=$GOVERNAUTHZER_ENCRYPTION_KEY_DERIVATION_SALT

# The restricted runtime role the app serves as...
GOVERNAUTHZER_DATABASE_PASSWORD=$GOVERNAUTHZER_DATABASE_PASSWORD
# ...and the same value handed to the db accessory's init script, which creates it.
GOVERNAUTHZER_APP_DB_PASSWORD=$GOVERNAUTHZER_DATABASE_PASSWORD

# Owner/migrator role — the in-container superuser "governauthzer". The app never
# sees this one: it is what keeps a compromised app process from rewriting the audit
# log, so it stays with whoever deploys.
POSTGRES_PASSWORD=$POSTGRES_PASSWORD

# Only read when SMTP_USER is set; config/deploy.production.yml lists it under
# env.secret in that case only, because Kamal fails on a secret it cannot resolve.
SMTP_PASSWORD=$SMTP_PASSWORD
