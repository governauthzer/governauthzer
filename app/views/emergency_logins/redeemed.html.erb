<% content_for :title, "Signed in — Governauthzer" %>

<div class="max-w-md w-full">
  <h1 class="page-title mb-4">Signed in</h1>
  <p class="mb-2">Welcome, <%= current_user.name %>.</p>
  <p class="mb-6 text-sm text-gray-600">
    <% if current_user.operator? %>
      You are signed in as an operator.
    <% else %>
      You are signed in.
    <% end %>
  </p>
  <div class="flex items-center gap-2">
    <%= link_to "Go to dashboard", root_path, class: "btn btn-primary btn-sm" %>
    <%= button_to "Sign out", logout_path, method: :delete, class: "btn btn-secondary btn-sm" %>
  </div>
</div>
