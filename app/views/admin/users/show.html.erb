<% content_for :title, "#{@user.name} — Governauthzer" %>
<% status_labels = { "active" => "Activate", "suspended" => "Suspend", "terminated" => "Terminate" } %>

<div class="max-w-5xl mx-auto">
  <%= render "admin/nav" %>
  <%= render "shared/flash" %>

  <div class="flex items-center justify-between mb-1">
    <h1 class="page-title"><%= @user.name %> <%= status_pill(@user.status) %></h1>
    <div class="flex items-center gap-2">
      <% @allowed_status_targets.each do |target| %>
        <%= button_to status_labels.fetch(target, target.humanize), admin_user_path(@user),
              method: :patch, params: { user: { status: target } },
              form: (target == "terminated" ? { data: { turbo_confirm: "Terminate #{@user.name}? This revokes all access." } } : {}),
              class: "btn btn-sm #{target == 'terminated' ? 'btn-danger' : 'btn-secondary'}" %>
      <% end %>
    </div>
  </div>
  <p class="text-sm text-gray-500 mb-1"><%= @user.email %></p>
  <p class="mb-8">
    <%= link_to "View audit log →", admin_audit_events_path(target_type: "User", target_id: @user.id),
          class: "text-xs text-copper-700 hover:underline" %>
  </p>

  <section class="mb-10">
    <h2 class="section-label mb-3">Profile</h2>
    <dl class="grid grid-cols-2 gap-y-2 text-sm max-w-lg">
      <dt class="text-gray-500">Department</dt><dd><%= @user.department.presence || "—" %></dd>
      <dt class="text-gray-500">Title</dt><dd><%= @user.title.presence || "—" %></dd>
      <dt class="text-gray-500">Manager</dt><dd><%= @user.manager&.name || "—" %></dd>
      <dt class="text-gray-500">Start date</dt><dd><%= @user.start_date&.iso8601 || "—" %></dd>
    </dl>
  </section>

  <section class="mb-10">
    <h2 class="section-label mb-3">Granted roles</h2>
    <% if @approved.empty? %>
      <p class="text-sm text-gray-500">None.</p>
    <% else %>
      <ul class="divide-y divide-gray-100 border-t border-gray-200 text-sm">
        <% @approved.each do |access| %>
          <li class="flex items-center justify-between py-2">
            <span>
              <span class="font-medium"><%= access.role.name %></span>
              <span class="text-gray-400">· <%= access.role.application.name %></span>
              <%= provisioning_pill(access.provisioning_status) %>
            </span>
            <%= button_to "Revoke", admin_access_path(access), method: :delete,
                  form: { data: { turbo_confirm: "Revoke #{access.role.name} from #{@user.name}?" } },
                  class: "btn-quiet text-xs" %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </section>

  <% if @pending.any? %>
    <section class="mb-10">
      <h2 class="section-label mb-3">Pending requests</h2>
      <ul class="divide-y divide-gray-100 border-t border-gray-200 text-sm">
        <% @pending.each do |access| %>
          <li class="py-2">
            <span class="font-medium"><%= access.role.name %></span>
            <span class="text-gray-400">· <%= access.role.application.name %></span>
            <% if access.current_approver %><span class="text-gray-400">· awaiting <%= access.current_approver.name %></span><% end %>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <section class="mb-10">
    <h2 class="section-label mb-3">HRIS identities</h2>
    <% if @external_identities.empty? %>
      <p class="text-sm text-gray-500">None.</p>
    <% else %>
      <ul class="divide-y divide-gray-100 border-t border-gray-200 text-sm">
        <% @external_identities.each do |ei| %>
          <li class="py-2"><span class="font-mono"><%= ei.source %></span> <span class="text-gray-400">/</span> <span class="font-mono"><%= ei.external_id %></span></li>
        <% end %>
      </ul>
    <% end %>
  </section>

  <section>
    <h2 class="section-label mb-3">Linked OIDC identities</h2>
    <% if @omniauth_identities.any? %>
      <ul class="divide-y divide-gray-100 border-t border-gray-200 text-sm mb-4">
        <% @omniauth_identities.each do |identity| %>
          <li class="flex items-center justify-between py-2">
            <span>
              <span class="font-medium"><%= identity.auth_provider.name %></span>
              <span class="text-gray-400">/</span>
              <span class="font-mono text-gray-700"><%= identity.subject %></span>
            </span>
            <%= button_to "Unlink", admin_omniauth_identity_path(identity), method: :delete,
                  form: { data: { turbo_confirm: "Unlink this identity? The user will lose OIDC login via it." } },
                  class: "btn-quiet text-xs" %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p class="text-sm text-gray-500 mb-4">No OIDC identities linked — this user cannot sign in via OIDC yet.</p>
    <% end %>

    <% if @providers.any? %>
      <%= form_with url: admin_user_omniauth_identities_path(@user), scope: :omniauth_identity, local: true,
            class: "flex flex-wrap items-end gap-3 max-w-2xl" do |f| %>
        <div>
          <%= f.label :auth_provider_id, "Provider", class: "field-label text-xs" %>
          <%= f.collection_select :auth_provider_id, @providers, :id, :name, {}, class: "#{input_class} w-48" %>
        </div>
        <div class="flex-1 min-w-[12rem]">
          <%= f.label :subject, "Subject claim", class: "field-label text-xs" %>
          <%= f.text_field :subject, required: true, placeholder: "sub value from the IdP", class: "#{input_class} font-mono" %>
        </div>
        <%= f.submit "Link identity", class: "btn btn-primary" %>
      <% end %>
    <% else %>
      <p class="text-xs text-gray-500">Configure an enabled OIDC provider first.</p>
    <% end %>
  </section>
</div>
