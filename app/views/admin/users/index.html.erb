<% content_for :title, "Users — Governauthzer" %>
<% pill = ->(label, path, active) {
     link_to label, path,
       class: "px-3 py-1.5 rounded-md text-sm transition-colors #{active ? 'bg-gray-900 text-white' : 'bg-gray-50 border border-gray-200 text-gray-700 hover:bg-gray-100'}"
   } %>

<div class="max-w-5xl mx-auto">
  <%= render "admin/nav" %>
  <%= render "shared/flash" %>

  <h1 class="page-title mb-6">Users</h1>

  <div class="flex flex-wrap gap-2 mb-6">
    <%= pill.("All", admin_users_path, @status.blank?) %>
    <% User::STATUSES.each do |status| %>
      <%= pill.(status.humanize, admin_users_path(status: status), @status == status) %>
    <% end %>
  </div>

  <% if @users.empty? %>
    <p class="text-sm text-gray-600">No users.</p>
  <% else %>
    <div class="panel">
      <table class="data-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Status</th>
            <th>Manager</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @users.each do |user| %>
            <tr class="row-hover">
              <td class="font-medium text-gray-900"><%= user.name %></td>
              <td class="text-gray-600"><%= user.email %></td>
              <td><%= status_pill(user.status) %></td>
              <td class="text-gray-600"><%= user.manager&.name || "—" %></td>
              <td class="text-right">
                <%= link_to "View", admin_user_path(user), class: "text-copper-700 hover:underline" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
