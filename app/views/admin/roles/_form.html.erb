<%= form_with model: role, url: url, scope: :role, local: true, class: "space-y-5 max-w-xl" do |f| %>
  <% if role.errors.any? %>
    <div class="p-3 rounded bg-gray-200 text-gray-800 text-sm space-y-1">
      <% role.errors.full_messages.each do |msg| %>
        <div>• <%= msg %></div>
      <% end %>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "block text-sm font-medium mb-1" %>
    <%= f.text_field :name, required: true, class: input_class %>
  </div>

  <div>
    <%= f.label :slug, class: "block text-sm font-medium mb-1" %>
    <%= f.text_field :slug, required: true, class: "#{input_class} font-mono" %>
    <p class="text-xs text-gray-500 mt-1">Unique within the application. Normalized to lowercase with dashes.</p>
  </div>

  <div>
    <%= f.label :approval_workflow_id, "Approval workflow", class: "block text-sm font-medium mb-1" %>
    <%= f.collection_select :approval_workflow_id, ApprovalWorkflow.order(:name), :id, :name,
                            { include_blank: "Default (manager approval)" }, class: input_class %>
    <p class="text-xs text-gray-500 mt-1">Which workflow gates requests for this role.</p>
  </div>

  <div class="flex items-center gap-2">
    <%= f.check_box :protected %>
    <%= f.label :protected, "Protected — operator-assigned only, not self-requestable", class: "text-sm" %>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= f.submit class: "px-4 py-2 bg-gray-900 text-white text-sm rounded hover:bg-gray-700" %>
    <%= link_to "Cancel", admin_application_path(role.application || @application), class: "text-sm underline" %>
  </div>
<% end %>
