<%= form_with model: [ :admin, @subscription ], local: true, class: "space-y-5" do |f| %>
  <% if @subscription.errors.any? %>
    <div class="p-3 rounded-lg bg-red-50 border border-red-200 text-red-800 text-sm space-y-1">
      <% @subscription.errors.full_messages.each do |msg| %>
        <div>• <%= msg %></div>
      <% end %>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "field-label" %>
    <%= f.text_field :name, required: true, class: input_class, placeholder: "Baton bridge, custom handler, ..." %>
  </div>

  <div>
    <%= f.label :endpoint_url, "Endpoint URL", class: "field-label" %>
    <%= f.url_field :endpoint_url, required: true, class: "#{input_class} font-mono", placeholder: "https://bridge.internal/hooks" %>
    <p class="field-hint">
      An <code>http://</code> or <code>https://</code> address. Plain HTTP is accepted for a
      bridge on this deployment's private network; anywhere else it puts the subject's name
      and email on the wire in clear.
    </p>
    <p class="field-hint">
      CloudEvents are POSTed here, HMAC-signed over the body. The signing secret is shown on the
      subscription page after you save.
    </p>
  </div>

  <div>
    <span class="field-label">Event types</span>
    <div class="space-y-1 mt-1">
      <% Outbound::CloudEventBuilder.published_types.each do |type| %>
        <label class="flex items-center gap-2 text-sm">
          <%= check_box_tag "webhook_subscription[event_types][]", type, @subscription.event_types.include?(type), id: nil %>
          <span class="font-mono text-xs"><%= type %></span>
        </label>
      <% end %>
    </div>
    <p class="field-hint">Leave all unchecked to receive every published event type.</p>
  </div>

  <div>
    <span class="field-label">Applications</span>
    <div class="space-y-1 mt-1">
      <% @form_applications.each do |app| %>
        <label class="flex items-center gap-2 text-sm">
          <%= check_box_tag "webhook_subscription[application_ids][]", app.id, @subscription.application_ids.include?(app.id), id: nil %>
          <span><%= app.name %></span>
        </label>
      <% end %>
    </div>
    <p class="field-hint">Leave all unchecked to receive events for every application.</p>
  </div>

  <label class="flex items-center gap-2 text-sm">
    <%= f.check_box :active %>
    <span>Active</span>
  </label>

  <div class="flex items-center gap-3 pt-2">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", admin_webhook_subscriptions_path, class: "btn-quiet" %>
  </div>
<% end %>
