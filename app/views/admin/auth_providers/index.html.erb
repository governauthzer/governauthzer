<% content_for :title, "OIDC providers — Governauthzer" %>

<div class="max-w-5xl mx-auto">
  <%= render "admin/nav" %>
  <%= render "shared/flash" %>

  <div class="flex items-center justify-between mb-6">
    <h1 class="page-title">OIDC providers</h1>
    <%= link_to "Add provider", new_admin_auth_provider_path,
                class: "btn btn-primary" %>
  </div>

  <% if @auth_providers.empty? %>
    <p class="text-sm text-gray-600">No identity providers configured yet.</p>
  <% else %>
    <div class="panel">
      <table class="data-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Slug</th>
            <th>Issuer</th>
            <th>Status</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @auth_providers.each do |provider| %>
            <tr class="row-hover">
              <td class="font-medium text-gray-900"><%= provider.name %></td>
              <td class="font-mono text-gray-700"><%= provider.slug %></td>
              <td class="text-gray-600 truncate max-w-xs"><%= provider.oidc_issuer_url %></td>
              <td>
                <% if provider.enabled %>
                  <span class="pill bg-gray-100 text-gray-700"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Enabled</span>
                <% else %>
                  <span class="pill bg-gray-100 text-gray-500"><span class="w-1.5 h-1.5 rounded-full bg-gray-400"></span>Disabled</span>
                <% end %>
              </td>
              <td class="text-right space-x-3">
                <%= link_to "Edit", edit_admin_auth_provider_path(provider), class: "text-copper-700 hover:underline" %>
                <%= button_to "Delete", admin_auth_provider_path(provider),
                              method: :delete,
                              form: { data: { turbo_confirm: "Delete #{provider.name}?" } },
                              class: "btn-quiet" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
