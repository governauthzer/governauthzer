<% content_for :title, "Applications — Governauthzer" %>

<div class="max-w-5xl mx-auto">
  <%= render "admin/nav" %>
  <%= render "shared/flash" %>

  <div class="flex items-center justify-between mb-6">
    <h1 class="page-title">Applications</h1>
    <%= link_to "Add application", new_admin_application_path,
                class: "btn btn-primary" %>
  </div>

  <% if @applications.empty? %>
    <p class="text-sm text-gray-600">No applications yet.</p>
  <% else %>
    <div class="panel">
      <table class="data-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Slug</th>
            <th>Roles</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @applications.each do |application| %>
            <tr class="row-hover">
              <td class="font-medium text-gray-900">
                <%= application.name %>
                <% if application.itself? %>
                  <span class="ml-1 text-xs text-gray-400">(system)</span>
                <% end %>
              </td>
              <td class="font-mono text-gray-700"><%= application.slug %></td>
              <td class="text-gray-600"><%= application.roles_count %></td>
              <td class="text-right">
                <%= link_to "View", admin_application_path(application), class: "text-copper-700 hover:underline" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
