<% content_for :title, "#{@application.name} — Governauthzer" %>

<div class="w-full max-w-5xl">
  <%= render "admin/nav" %>
  <%= render "shared/flash" %>

  <div class="flex items-center justify-between mb-1">
    <h1 class="text-2xl font-semibold">
      <%= @application.name %>
      <% if @application.itself? %><span class="ml-1 text-sm text-gray-400">(system)</span><% end %>
    </h1>
    <% unless @application.itself? %>
      <div class="flex items-center gap-3">
        <%= link_to "Edit", edit_admin_application_path(@application), class: "text-sm underline" %>
        <%= button_to "Delete", admin_application_path(@application), method: :delete,
              form: { data: { turbo_confirm: "Delete #{@application.name}?" } },
              class: "text-sm text-gray-500 hover:underline" %>
      </div>
    <% end %>
  </div>
  <p class="font-mono text-sm text-gray-500 mb-8"><%= @application.slug %></p>

  <div class="flex items-center justify-between mb-4">
    <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Roles</h2>
    <% unless @application.itself? %>
      <%= link_to "Add role", new_admin_application_role_path(@application),
                  class: "px-3 py-1.5 bg-gray-900 text-white text-sm rounded hover:bg-gray-700" %>
    <% end %>
  </div>

  <% if @roles.empty? %>
    <p class="text-sm text-gray-600">No roles defined.</p>
  <% else %>
    <table class="w-full text-sm border-t border-gray-200">
      <thead>
        <tr class="text-left text-gray-500">
          <th class="py-2 pr-4 font-medium">Name</th>
          <th class="py-2 pr-4 font-medium">Slug</th>
          <th class="py-2 pr-4 font-medium">Approval</th>
          <th class="py-2 pr-4 font-medium"></th>
          <th class="py-2 pr-4 font-medium"></th>
        </tr>
      </thead>
      <tbody>
        <% @roles.each do |role| %>
          <tr class="border-t border-gray-100">
            <td class="py-3 pr-4 font-medium">
              <%= role.name %>
              <% if role.protected? %>
                <span class="ml-1 text-xs text-copper-700">protected</span>
              <% end %>
            </td>
            <td class="py-3 pr-4 font-mono text-gray-700"><%= role.slug %></td>
            <td class="py-3 pr-4 text-gray-600">
              <%= role.approval_workflow&.name || "Default (manager approval)" %>
            </td>
            <% if @application.itself? %>
              <td class="py-3 pr-4 text-gray-400 text-xs" colspan="2">system-managed</td>
            <% else %>
              <td class="py-3 pr-4 text-right">
                <%= link_to "Edit", edit_admin_role_path(role), class: "text-copper-700 hover:underline" %>
              </td>
              <td class="py-3 pr-4 text-right">
                <%= button_to "Delete", admin_role_path(role), method: :delete,
                      form: { data: { turbo_confirm: "Delete #{role.name}?" } },
                      class: "text-gray-500 hover:underline" %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
