<% content_for :title, "#{@application.name} — Governauthzer" %>

<div class="max-w-5xl mx-auto">
  <%= render "admin/nav" %>
  <%= render "shared/flash" %>

  <div class="flex items-center justify-between mb-1">
    <h1 class="page-title">
      <%= @application.name %>
      <% if @application.itself? %><span class="ml-1 text-sm text-gray-400">(system)</span><% end %>
    </h1>
    <% unless @application.itself? %>
      <div class="flex items-center gap-2">
        <%= link_to "Edit", edit_admin_application_path(@application), class: "btn btn-secondary btn-sm" %>
        <%= button_to "Delete", admin_application_path(@application), method: :delete,
              form: { data: { turbo_confirm: "Delete #{@application.name}?" } },
              class: "btn-quiet" %>
      </div>
    <% end %>
  </div>
  <p class="font-mono text-sm text-gray-500 mb-8"><%= @application.slug %></p>

  <div class="flex items-center justify-between mb-4">
    <h2 class="section-label">Roles</h2>
    <% unless @application.itself? %>
      <%= link_to "Add role", new_admin_application_role_path(@application),
                  class: "btn btn-primary btn-sm" %>
    <% end %>
  </div>

  <% if @roles.empty? %>
    <p class="text-sm text-gray-600">No roles defined.</p>
  <% else %>
    <div class="panel">
      <table class="data-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Slug</th>
            <th>Approval</th>
            <th></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @roles.each do |role| %>
            <tr class="row-hover">
              <td class="font-medium text-gray-900">
                <%= role.name %>
                <% if role.protected? %>
                  <span class="ml-1.5 pill bg-copper-50 text-copper-700">protected</span>
                <% end %>
              </td>
              <td class="font-mono text-gray-700"><%= role.slug %></td>
              <td class="text-gray-600">
                <%= role.approval_workflow&.name || "Default (manager approval)" %>
              </td>
              <% if @application.itself? %>
                <td class="text-gray-400 text-xs" colspan="2">system-managed</td>
              <% else %>
                <td class="text-right">
                  <%= link_to "Edit", edit_admin_role_path(role), class: "text-copper-700 hover:underline" %>
                </td>
                <td class="text-right">
                  <%= button_to "Delete", admin_role_path(role), method: :delete,
                        form: { data: { turbo_confirm: "Delete #{role.name}?" } },
                        class: "btn-quiet" %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
