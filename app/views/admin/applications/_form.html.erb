<%= form_with model: [ :admin, application ], local: true, class: "space-y-5 max-w-xl" do |f| %>
  <% if application.errors.any? %>
    <div class="p-3 rounded-lg bg-red-50 border border-red-200 text-red-800 text-sm space-y-1">
      <% application.errors.full_messages.each do |msg| %>
        <div>• <%= msg %></div>
      <% end %>
    </div>
  <% end %>

  <div>
    <%= f.label :name, class: "field-label" %>
    <%= f.text_field :name, required: true, class: input_class %>
  </div>

  <div>
    <%= f.label :slug, class: "field-label" %>
    <%= f.text_field :slug, required: true, class: "#{input_class} font-mono" %>
    <p class="field-hint">Stable identifier. Normalized to lowercase with dashes.</p>
  </div>

  <div class="flex items-center gap-3 pt-2">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", admin_applications_path, class: "btn-quiet" %>
  </div>
<% end %>
