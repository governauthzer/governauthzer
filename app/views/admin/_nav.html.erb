<% nav_link = ->(label, path, active) {
     link_to label, path,
       class: "shrink-0 px-3 py-1.5 rounded-md text-sm transition-colors #{active ? 'bg-gray-900 text-white' : 'text-gray-600 hover:text-gray-900 hover:bg-gray-100'}"
   } %>

<div class="fixed top-3 inset-x-0 z-40">
  <div class="container mx-auto px-5">
    <header class="max-w-5xl mx-auto flex items-center justify-between gap-3
                   h-12 pl-2 pr-2 rounded-lg bg-white/90 backdrop-blur shadow-md">
      <div class="flex items-center gap-1 min-w-0 overflow-x-auto">
        <%= link_to admin_root_path, class: "shrink-0 flex items-center justify-center w-7 h-7 mr-0.5" do %>
          <svg class="w-7 h-7" viewBox="0 0 48 48" aria-hidden="true">
            <polygon points="12,10 36,10 27,19 21,19" fill="#b85e2a"></polygon>
            <polygon points="38,12 38,36 29,27 29,21" fill="#0f0f0f"></polygon>
            <polygon points="36,38 12,38 21,29 27,29" fill="#0f0f0f"></polygon>
            <polygon points="10,36 10,12 19,21 19,27" fill="#0f0f0f"></polygon>
          </svg>
        <% end %>
        <%= nav_link.("Dashboard", admin_root_path, controller_name == "dashboard") %>
        <%= nav_link.("Applications", admin_applications_path, controller_name.in?(%w[applications roles])) %>
        <%= nav_link.("Workflows", admin_approval_workflows_path, controller_name.in?(%w[approval_workflows approval_steps])) %>
        <%= nav_link.("Users", admin_users_path, controller_name.in?(%w[users omniauth_identities])) %>
        <%= nav_link.("Audit log", admin_audit_events_path, controller_name == "audit_events") %>
        <%= nav_link.("OIDC", admin_auth_providers_path, controller_name == "auth_providers") %>
        <%= nav_link.("API tokens", admin_api_tokens_path, controller_name == "api_tokens") %>
        <%= nav_link.("Webhooks", admin_webhook_subscriptions_path, controller_name == "webhook_subscriptions") %>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        <span class="hidden lg:inline text-sm text-gray-400"><%= current_user.name %></span>
        <%= link_to "App ↗", root_path, class: "shrink-0 px-3 py-1.5 rounded-md text-sm text-copper-700 font-medium hover:bg-copper-50" %>
      </div>
    </header>
  </div>
</div>
<div class="h-12" aria-hidden="true"></div>
