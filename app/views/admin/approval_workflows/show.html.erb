<% content_for :title, "#{@workflow.name} — Governauthzer" %>

<div class="w-full max-w-5xl">
  <%= render "admin/nav" %>
  <%= render "shared/flash" %>

  <div class="flex items-center justify-between mb-1">
    <h1 class="text-2xl font-semibold">
      <%= @workflow.name %>
      <% if @workflow.slug == ApprovalWorkflow::DEFAULT_SLUG %>
        <span class="ml-1 text-sm text-gray-400">(default)</span>
      <% end %>
    </h1>
    <div class="flex items-center gap-3">
      <%= link_to "Edit", edit_admin_approval_workflow_path(@workflow), class: "text-sm underline" %>
      <% unless @workflow.slug == ApprovalWorkflow::DEFAULT_SLUG %>
        <%= button_to "Delete", admin_approval_workflow_path(@workflow), method: :delete,
              form: { data: { turbo_confirm: "Delete #{@workflow.name}?" } },
              class: "text-sm text-gray-500 hover:underline" %>
      <% end %>
    </div>
  </div>
  <p class="font-mono text-sm text-gray-500 mb-8"><%= @workflow.slug %></p>

  <div class="flex items-center justify-between mb-4">
    <h2 class="text-sm font-semibold text-gray-500 uppercase tracking-wide">Steps (in order)</h2>
    <%= link_to "Add step", new_admin_approval_workflow_approval_step_path(@workflow),
                class: "px-3 py-1.5 bg-gray-900 text-white text-sm rounded hover:bg-gray-700" %>
  </div>

  <% if @steps.empty? %>
    <p class="text-sm text-gray-600">No steps — requests on roles using this workflow are auto-approved.</p>
  <% else %>
    <table class="w-full text-sm border-t border-gray-200">
      <thead>
        <tr class="text-left text-gray-500">
          <th class="py-2 pr-4 font-medium">#</th>
          <th class="py-2 pr-4 font-medium">Approver</th>
          <th class="py-2 pr-4 font-medium">Fallback</th>
          <th class="py-2 pr-4 font-medium"></th>
          <th class="py-2 pr-4 font-medium"></th>
        </tr>
      </thead>
      <tbody>
        <% @steps.each_with_index do |step, i| %>
          <tr class="border-t border-gray-100">
            <td class="py-3 pr-4 text-gray-500"><%= i + 1 %></td>
            <td class="py-3 pr-4">
              <%= step.strategy.humanize %>
              <% if step.strategy == "named_user" %>
                <span class="text-gray-500">· <%= step.approver_user&.name %></span>
              <% end %>
            </td>
            <td class="py-3 pr-4 text-gray-600"><%= step.fallback_user.name %></td>
            <td class="py-3 pr-4 text-right">
              <%= link_to "Edit", edit_admin_approval_step_path(step), class: "text-copper-700 hover:underline" %>
            </td>
            <td class="py-3 pr-4 text-right">
              <%= button_to "Remove", admin_approval_step_path(step), method: :delete,
                    form: { data: { turbo_confirm: "Remove this step?" } },
                    class: "text-gray-500 hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
