<% content_for :title, "#{@workflow.name} — Governauthzer" %>

<div class="max-w-5xl mx-auto">
  <%= render "admin/nav" %>
  <%= render "shared/flash" %>

  <div class="flex items-center justify-between mb-1">
    <h1 class="page-title">
      <%= @workflow.name %>
      <% if @workflow.slug == ApprovalWorkflow::DEFAULT_SLUG %>
        <span class="ml-1 text-sm text-gray-400">(default)</span>
      <% end %>
    </h1>
    <div class="flex items-center gap-2">
      <%= link_to "Edit", edit_admin_approval_workflow_path(@workflow), class: "btn btn-secondary btn-sm" %>
      <% unless @workflow.slug == ApprovalWorkflow::DEFAULT_SLUG %>
        <%= button_to "Delete", admin_approval_workflow_path(@workflow), method: :delete,
              form: { data: { turbo_confirm: "Delete #{@workflow.name}?" } },
              class: "btn-quiet" %>
      <% end %>
    </div>
  </div>
  <p class="font-mono text-sm text-gray-500 mb-8"><%= @workflow.slug %></p>

  <div class="flex items-center justify-between mb-4">
    <h2 class="section-label">Steps (in order)</h2>
    <%= link_to "Add step", new_admin_approval_workflow_approval_step_path(@workflow),
                class: "btn btn-primary btn-sm" %>
  </div>

  <% if @steps.empty? %>
    <p class="text-sm text-gray-600">No steps — requests on roles using this workflow are auto-approved.</p>
  <% else %>
    <div class="panel">
      <table class="data-table">
        <thead>
          <tr>
            <th>#</th>
            <th>Approver</th>
            <th>Fallback</th>
            <th></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @steps.each_with_index do |step, i| %>
            <tr class="row-hover">
              <td class="text-gray-500 tabular-nums"><%= i + 1 %></td>
              <td class="text-gray-900">
                <%= step.strategy.humanize %>
                <% if step.strategy == "named_user" %>
                  <span class="text-gray-500">· <%= step.approver_user&.name %></span>
                <% end %>
              </td>
              <td class="text-gray-600"><%= step.fallback_user.name %></td>
              <td class="text-right">
                <%= link_to "Edit", edit_admin_approval_step_path(step), class: "text-copper-700 hover:underline" %>
              </td>
              <td class="text-right">
                <%= button_to "Remove", admin_approval_step_path(step), method: :delete,
                      form: { data: { turbo_confirm: "Remove this step?" } },
                      class: "btn-quiet" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
