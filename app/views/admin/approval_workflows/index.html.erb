<% content_for :title, "Workflows — Governauthzer" %>

<div class="max-w-5xl mx-auto">
  <%= render "admin/nav" %>
  <%= render "shared/flash" %>

  <div class="flex items-center justify-between mb-6">
    <h1 class="page-title">Approval workflows</h1>
    <%= link_to "Add workflow", new_admin_approval_workflow_path,
                class: "btn btn-primary" %>
  </div>

  <% if @workflows.empty? %>
    <p class="text-sm text-gray-600">No workflows yet.</p>
  <% else %>
    <div class="panel">
      <table class="data-table">
        <thead>
          <tr>
            <th>Name</th>
            <th>Slug</th>
            <th>Steps</th>
            <th>Roles using it</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @workflows.each do |workflow| %>
            <tr class="row-hover">
              <td class="font-medium text-gray-900">
                <%= workflow.name %>
                <% if workflow.slug == ApprovalWorkflow::DEFAULT_SLUG %>
                  <span class="ml-1 text-xs text-gray-400">(default)</span>
                <% end %>
              </td>
              <td class="font-mono text-gray-700"><%= workflow.slug %></td>
              <td class="text-gray-600"><%= workflow.steps_count %></td>
              <td class="text-gray-600"><%= workflow.roles_count %></td>
              <td class="text-right">
                <%= link_to "View", admin_approval_workflow_path(workflow), class: "text-copper-700 hover:underline" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
