<% content_for :title, "Audit log — Governauthzer" %>

<div class="max-w-5xl mx-auto">
  <%= render "admin/nav" %>

  <h1 class="page-title mb-6">Audit log</h1>

  <%= form_with url: admin_audit_events_path, method: :get, local: true,
        class: "card p-4 flex flex-wrap items-end gap-3 mb-6 text-sm" do %>
    <div>
      <label class="field-label text-xs">Event type</label>
      <%= select_tag :event_type,
            options_for_select([ [ "All", "" ] ] + @event_types.map { |t| [ t, t ] }, params[:event_type]),
            class: "input w-56" %>
    </div>
    <div>
      <label class="field-label text-xs">Actor</label>
      <%= text_field_tag :actor, params[:actor], placeholder: "name or email", class: "input w-44" %>
    </div>
    <div>
      <label class="field-label text-xs">From</label>
      <%= date_field_tag :from, params[:from], class: "input" %>
    </div>
    <div>
      <label class="field-label text-xs">To</label>
      <%= date_field_tag :to, params[:to], class: "input" %>
    </div>
    <%= hidden_field_tag :correlation_id, params[:correlation_id] if params[:correlation_id].present? %>
    <%= submit_tag "Filter", class: "btn btn-primary" %>
    <%= link_to "Clear", admin_audit_events_path, class: "btn btn-secondary" %>
  <% end %>

  <% if params[:correlation_id].present? %>
    <p class="text-xs text-gray-500 mb-3">
      Filtered to correlation <span class="font-mono"><%= params[:correlation_id] %></span> ·
      <%= link_to "remove", admin_audit_events_path(request.query_parameters.except("correlation_id")), class: "underline" %>
    </p>
  <% end %>

  <p class="text-xs text-gray-500 mb-3"><%= @total %> event<%= "s" unless @total == 1 %></p>

  <% if @events.empty? %>
    <p class="text-sm text-gray-600">No events match.</p>
  <% else %>
    <div class="panel">
      <table class="data-table">
        <thead>
          <tr>
            <th class="whitespace-nowrap">Time (UTC)</th>
            <th>Event</th>
            <th>Actor</th>
            <th>Targets</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @events.each do |event| %>
            <tr class="row-hover align-top">
              <td class="whitespace-nowrap text-gray-500 font-mono text-xs">
                <%= event.occurred_at.utc.strftime("%Y-%m-%d %H:%M:%S") %>
              </td>
              <td class="font-mono text-gray-900"><%= event.event_type %></td>
              <td class="text-gray-700"><%= event.actor_display || "system" %></td>
              <td class="text-gray-500 truncate max-w-xs">
                <%= event.targets.map { |t| t["display"] }.compact.join(", ").presence || "—" %>
              </td>
              <td class="text-right">
                <%= link_to "Details", admin_audit_event_path(event), class: "text-copper-700 hover:underline" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="flex items-center justify-between mt-6 text-sm">
      <span class="text-gray-500">Page <%= @page %> of <%= @pages %></span>
      <div class="flex gap-3">
        <% if @page > 1 %>
          <%= link_to "← Prev", admin_audit_events_path(request.query_parameters.merge(page: @page - 1)), class: "underline" %>
        <% end %>
        <% if @page < @pages %>
          <%= link_to "Next →", admin_audit_events_path(request.query_parameters.merge(page: @page + 1)), class: "underline" %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
