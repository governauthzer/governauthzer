<% content_for :title, "Request access — Governauthzer" %>

<div class="max-w-5xl mx-auto">
  <%= render "shared/topbar" %>
  <%= render "shared/flash" %>

  <h1 class="page-title mb-1">Request access</h1>
  <p class="page-subtitle mb-6">Browse roles you can request. Each goes to its approval workflow.</p>

  <% if @roles.empty? %>
    <p class="text-sm text-gray-500">There are no roles available to request.</p>
  <% else %>
    <ul class="space-y-3">
      <% @roles.each do |role| %>
        <li class="card card-hover p-4">
          <div class="mb-2.5">
            <span class="font-medium text-gray-900"><%= role.name %></span>
            <span class="text-gray-400 text-sm">· <%= role.application.name %></span>
          </div>
          <%= form_with url: access_requests_path, method: :post do %>
            <%= hidden_field_tag :role_id, role.id %>
            <%= text_field_tag :justification, nil, placeholder: "Why do you need this? (optional)", class: "input mb-2" %>
            <%= submit_tag "Request", class: "btn btn-primary btn-sm" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
