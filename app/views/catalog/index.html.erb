<% content_for :title, "Request access — Governauthzer" %>

<div class="max-w-5xl mx-auto">
  <%= render "shared/topbar" %>
  <%= render "shared/flash" %>

  <div class="max-w-lg mx-auto mt-8">
    <h1 class="page-title mb-1 text-center">Request access</h1>
    <p class="page-subtitle mb-6 text-center">Search for an application, then the role you need.</p>

    <% if @roles.empty? %>
      <p class="text-sm text-gray-500 text-center">There are no roles available to request.</p>
    <% else %>
      <div class="card p-6"
           data-controller="role-picker"
           data-role-picker-roles-value="<%= @roles.map { |r| { id: r.id, name: r.name, app: r.application.name } }.to_json %>">
        <%= form_with url: access_requests_path, method: :post do %>
          <div class="mb-4">
            <label class="field-label" for="rp-application">Application</label>
            <input id="rp-application" type="text" list="rp-applications" autocomplete="off"
                   placeholder="Search applications…" class="input"
                   data-role-picker-target="app"
                   data-action="input->role-picker#appChanged">
            <datalist id="rp-applications">
              <% @applications.each do |application| %>
                <option value="<%= application.name %>"></option>
              <% end %>
            </datalist>
          </div>

          <div class="mb-4">
            <label class="field-label" for="rp-role">Role</label>
            <input id="rp-role" type="text" list="rp-roles" autocomplete="off"
                   placeholder="Select an application first" class="input" disabled
                   data-role-picker-target="role"
                   data-action="input->role-picker#roleChanged">
            <datalist id="rp-roles" data-role-picker-target="roleList"></datalist>
            <p class="field-hint">Only roles for the selected application.</p>
          </div>

          <%= hidden_field_tag :role_id, nil, data: { "role-picker-target": "roleId" } %>

          <div class="mb-5">
            <label class="field-label" for="rp-justification">Justification <span class="text-gray-400 font-normal">(optional)</span></label>
            <%= text_area_tag :justification, nil, id: "rp-justification", rows: 2,
                  placeholder: "Why do you need this?", class: "input" %>
          </div>

          <%= submit_tag "Request access", class: "btn btn-primary w-full", disabled: true,
                data: { "role-picker-target": "submit" } %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
