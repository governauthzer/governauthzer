<% content_for :title, "Sign in — Governauthzer" %>

<div class="w-full max-w-sm">
  <h1 class="text-2xl font-semibold mb-6">Sign in</h1>

  <% if @auth_providers.any? %>
    <div class="space-y-3">
      <% @auth_providers.each do |provider| %>
        <%= button_to "Sign in with #{provider.name}",
                      "/auth/#{provider.slug}",
                      method: :post,
                      data: { turbo: false },
                      class: "w-full px-4 py-3 bg-gray-900 text-white rounded text-sm hover:bg-gray-700" %>
      <% end %>
    </div>
  <% else %>
    <p class="text-sm text-gray-600">
      No identity providers are configured. If you are an operator without IdP access,
      use the <code>bin/governauthzer emergency-login</code> CLI to obtain a one-time login URL.
    </p>
  <% end %>

  <% if Rails.env.development? %>
    <div class="mt-6 pt-6 border-t border-gray-200">
      <%= link_to "Developer sign-in →", dev_sign_in_path, class: "text-sm text-copper-700 hover:underline" %>
    </div>
  <% end %>
</div>
